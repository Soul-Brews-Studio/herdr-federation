# the incubation breadcrumb — machine-local provenance, not source
.claude/INCUBATED_BY

# build output and deps
node_modules/
dist/
web/tsconfig.tsbuildinfo
# SwiftPM: .build holds the object tree AND the generated .app bundle
app/tray/.build/
app/node/.build/
app/node/Package.resolved.lock

# runtime state: this node's identity, its peers, its message log
peers.json
.fed-state.json
# secrets: the node's private key, and every member/invite token it holds
.fed-identity.json
.fed-members.json

# scratch
.tmp/
.demo/
